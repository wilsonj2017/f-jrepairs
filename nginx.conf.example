# ==============================================================================
# F&J REPAIRS SRL - Configuración Recomendada de Nginx (Reverse Proxy & Static)
# ==============================================================================
# Colocar este archivo en: /etc/nginx/sites-available/fjrepairs
# Y habilitar con: sudo ln -s /etc/nginx/sites-available/fjrepairs /etc/nginx/sites-enabled/
# Luego recargar: sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

server {
    listen 3000;
    server_name _;

    # Ruta absoluta donde clonó o copió el proyecto en su servidor Linux
    root /var/www/f-jrepairs;
    index index.html mobile.html;

    # Compresión gzip para máxima velocidad
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Archivos estáticos principales (HTML, CSS, JS, imágenes, db.json)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso hacia el backend de Node.js (corriendo en el puerto 3001 con PM2)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 25M;
    }

    # Cache para activos estáticos
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
